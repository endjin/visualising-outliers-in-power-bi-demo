model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["WorkflowProcessingTimes","ItemSummary","DAX Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table WorkflowProcessingTimes
ref table 'DAX Measures'
ref table ItemSummary

ref cultureInfo en-GB

