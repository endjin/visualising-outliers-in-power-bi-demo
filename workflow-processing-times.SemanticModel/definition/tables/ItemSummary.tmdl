/// One row per work item, with the total time spent across all workflow states. Drives the item-level statistics and the distribution histogram.
table ItemSummary
	lineageTag: 5f34aba0-781c-42b5-97c1-61f8b916a45b

	column ItemId
		dataType: string
		isKey
		lineageTag: 1340c54b-ac33-4ab2-8d2b-1d1527ce8e31
		summarizeBy: none
		sourceColumn: ItemId

	column Category
		dataType: string
		lineageTag: e34275ac-7507-4f43-bfe4-f5a46deaf429
		summarizeBy: none
		sourceColumn: Category

	column Priority
		dataType: string
		lineageTag: 16a215a8-21bb-4d1a-9e0e-2b2f3c1f771a
		summarizeBy: none
		sourceColumn: Priority

	/// Minutes spent across all workflow states.
	column TotalProcessingTime
		dataType: int64
		formatString: #,0
		lineageTag: 98dcb8c5-f389-45e0-9aee-a03e0eb0e6d4
		summarizeBy: sum
		sourceColumn: TotalProcessingTime

	/// Earliest ProcessedDate for the item.
	column StartDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: 5643f3d5-4e94-4e5c-924a-e3301a5b1325
		summarizeBy: none
		sourceColumn: StartDate

		annotation UnderlyingDateTimeDataType = Date

	column TotalTimeBucket
		dataType: string
		lineageTag: 9b976e55-7daa-4713-9491-8924cb0d0ba3
		summarizeBy: none
		sourceColumn: TotalTimeBucket
		sortByColumn: TotalTimeBucketSort

	column TotalTimeBucketSort
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 00803eca-d1d5-4623-87da-68af1afbc2f6
		summarizeBy: none
		sourceColumn: TotalTimeBucketSort

	/// Monday of the week the item started, for weekly trend charts.
	column WeekStarting = ItemSummary[StartDate] - WEEKDAY(ItemSummary[StartDate], 2) + 1
		dataType: dateTime
		formatString: d MMM
		lineageTag: 290938a0-d54b-493c-a8a3-159a9ffd7cf1
		dataCategory: Date
		summarizeBy: none

	/// "Outlier" when the item's total time exceeds the Outlier Threshold, otherwise "Normal". Lets any visual filter or split by outlier status.
	column ItemType = IF(ItemSummary[TotalProcessingTime] > [Outlier Threshold], "Outlier", "Normal")
		dataType: string
		lineageTag: 6b1f0c2e-8d4a-4f7b-9e21-3c5d7a8b9f10
		summarizeBy: none

	partition ItemSummary = m
		mode: import
		source =
				let
				    Source = WorkflowProcessingTimes,
				    Grouped = Table.Group(Source, {"ItemId", "Category", "Priority"}, {{"TotalProcessingTime", each List.Sum([ProcessingTimeMinutes]), Int64.Type}, {"StartDate", each List.Min([ProcessedDate]), type date}}),
				    #"Added TotalTimeBucket" = Table.AddColumn(Grouped, "TotalTimeBucket", each
				        if [TotalProcessingTime] <= 30 then "00-30 mins"
				        else if [TotalProcessingTime] <= 60 then "30-60 mins"
				        else if [TotalProcessingTime] <= 90 then "60-90 mins"
				        else if [TotalProcessingTime] <= 120 then "90-120 mins"
				        else if [TotalProcessingTime] <= 240 then "2-4 hours"
				        else if [TotalProcessingTime] <= 480 then "4-8 hours"
				        else "8+ hours", type text),
				    #"Added TotalTimeBucketSort" = Table.AddColumn(#"Added TotalTimeBucket", "TotalTimeBucketSort", each
				        if [TotalProcessingTime] <= 30 then 1
				        else if [TotalProcessingTime] <= 60 then 2
				        else if [TotalProcessingTime] <= 90 then 3
				        else if [TotalProcessingTime] <= 120 then 4
				        else if [TotalProcessingTime] <= 240 then 5
				        else if [TotalProcessingTime] <= 480 then 6
				        else 7, Int64.Type)
				in
				    #"Added TotalTimeBucketSort"

