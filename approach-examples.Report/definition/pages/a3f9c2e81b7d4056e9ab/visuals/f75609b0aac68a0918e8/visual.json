  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "BOX PLOT",
                    "textStyle": {
                      "fontFamily": "Segoe (Bold)",
                      "fontSize": "24pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A box plot summarises the distribution of processing time in each workflow state. The box spans the middle 50% of items (25th to 75th percentile), the line inside it is the median, and the whiskers extend to 1.5 times the interquartile range. Anything beyond the whiskers is drawn as an individual point."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Top chart (Full Range)",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The outliers force the axis out to 10 days, squashing every box into a line at the bottom, in the same way as the standard bar chart on The Visualisation Challenge page."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Bottom chart (Capped Axis)",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Capping the axis at 90 minutes makes the boxes readable, so you can compare typical times and spread across states at a glance. The outliers are now off the chart entirely, so this view needs pairing with one that shows them."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Note",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Box plots are not built into Power BI. This page uses the Box and Whisker Chart by MAQ Software, available from AppSource."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Box plots also need explaining as many senior stakeholders have never read one. Use them for analytical audiences rather than executive dashboards.",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
