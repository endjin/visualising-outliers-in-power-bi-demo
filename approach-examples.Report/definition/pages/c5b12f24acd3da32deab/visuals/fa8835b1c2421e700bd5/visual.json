                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Limitation",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ": You cannot see the actual magnitude of outliers from this view. Items that took 3 hours vs 10 days both appear as capped bars. Use this for quick identification, then drill through for details."
