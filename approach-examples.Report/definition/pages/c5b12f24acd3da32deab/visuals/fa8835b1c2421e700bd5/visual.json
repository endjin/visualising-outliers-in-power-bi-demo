              {
                "textRuns": [
                  {
                    "value": "This chart caps all values at 120 minutes, with outliers shown in orange/red. This allows you to:"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "See the distribution of normal processing times clearly"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Quickly identify which items are outliers (based on their total processing time)"
