        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "TRENDS OVER TIME",
                    "textStyle": {
                      "fontFamily": "Segoe (Bold)",
                      "fontSize": "24pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The other pages show a snapshot. These charts show whether the outliers are a one-off or a pattern, which is usually the question asked next."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Top chart (Dual Axis)",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The line is the median item total time each week, on the left axis. The columns are the number of outliers each week, on the right axis. Each series gets a scale that suits it."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "All five outliers fall in the first three weeks, while the median barely moves: the delays are isolated incidents, not a slowdown."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Bottom chart (Small Multiples)",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "One panel per workflow state, each with its own y-axis, showing the average time per step each week. Validation and Processing spike in the weeks containing outliers."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Note",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Independent axes make each panel readable but defeat comparison between panels: the spikes in Validation and Processing are thousands of minutes, the variation elsewhere is a few. Label the axes clearly, or share the axis when comparison matters more than detail."
                  }
                ]
              }
            ]
          }
        }
